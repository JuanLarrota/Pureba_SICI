# Copia este archivo como .env.local y completa los dos primeros valores (en Vercel, van como variables de entorno).
# Ninguno es secreto: la URL y la llave publicable del proyecto de Supabase que quieras usar.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_KEY=

# El «ID de cliente» de Google Cloud para leer Drive dentro de la aplicación. Vacío: solo el botón de abrir la carpeta.
# NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# «demo»: Supabase de mentira con public/demo/datos.json; no guarda nada. Mejor usar `npm run demo`.
# NEXT_PUBLIC_MODO=
# NEXT_PUBLIC_DEMO_PERSONA
